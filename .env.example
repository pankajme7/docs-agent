# Hosted provider: openai | ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama exposes an OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M

# The model prices are configurable because API prices change.
# Set these to the current price for your selected model, per 1 million tokens.
OPENAI_INPUT_PRICE_PER_1M=
OPENAI_OUTPUT_PRICE_PER_1M=

# RAG settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=kubernetes_docs
DEFAULT_TOP_K=4
BASELINE_TOP_K=8
OPTIMIZED_TOP_K=4
BASELINE_CONTEXT_CHARS=14000
OPTIMIZED_CONTEXT_CHARS=6500
CHUNK_WORDS=145
CHUNK_OVERLAP_WORDS=28

# MCP server
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# Generation
MAX_OUTPUT_TOKENS=900
TEMPERATURE=0.1
